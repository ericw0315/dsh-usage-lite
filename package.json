{
  "name": "dsh-usage-lite",
  "description": "Compact provider balances and local token-usage analytics for dsh web",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericw0315/dsh-usage-lite.git"
  },
  "homepage": "https://github.com/ericw0315/dsh-usage-lite#readme",
  "bugs": {
    "url": "https://github.com/ericw0315/dsh-usage-lite/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "token-usage",
    "provider-balance"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check scripts/test-bundle.mjs && node --check scripts/test-server.mjs && node --check scripts/smoke-client.mjs",
    "test": "node scripts/test-bundle.mjs && node scripts/test-server.mjs && node scripts/smoke-client.mjs"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
